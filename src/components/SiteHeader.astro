---
import { getRelativeLocaleUrl } from 'astro:i18n'
import LanguageSwitch from './LanguageSwitch.astro'
import { links, site } from '../data/site'
import { l, useTranslations, type Lang } from '../i18n'

interface Props {
  lang: Lang
  path?: string // page path without the language prefix, e.g. 'archive/'
}
const { lang, path = '' } = Astro.props
const t = useTranslations(lang)
const home = getRelativeLocaleUrl(lang)
// The current section's link turns bold. An invisible bold copy of the label reserves its width, so nothing shifts.
const navLink = 'inline-flex min-h-10 shrink-0 flex-col justify-center text-ink underline decoration-rule underline-offset-4 hover:decoration-ink aria-[current=location]:font-bold aria-[current=location]:decoration-ink after:invisible after:h-0 after:overflow-hidden after:font-bold after:content-[attr(data-label)]'
---

<!-- Stays at the top while scrolling; the paper background extends to the window edges.
     Narrow screens show the tabs in a second row that scrolls sideways. -->
<header data-site-header class="group/header sticky top-0 z-30 flex flex-wrap items-center justify-between gap-x-4 border-b border-rule bg-paper pt-3 shadow-[0_0_0_100vmax_var(--color-paper)] [clip-path:inset(0_-100vmax)] sm:gap-x-8 md:flex-nowrap md:py-4">
  <a class="block shrink-0" href={home}>
    <img class="block h-12 w-auto sm:h-18 group-data-[scrolled=true]/header:h-9 sm:group-data-[scrolled=true]/header:h-12 motion-safe:transition-[height] dark:invert" src={`${import.meta.env.BASE_URL}logo.svg`} width="1264" height="588" alt={site.name} />
  </a>
  <nav aria-label={t('mainNavigation')} data-nav class="relative order-last -mx-5 flex w-[calc(100%+2.5rem)] gap-5 overflow-x-auto px-5 pb-1 text-base whitespace-nowrap [scrollbar-width:none] sm:-mx-8 sm:w-[calc(100%+4rem)] sm:px-8 md:order-none md:mx-0 md:ml-auto md:w-auto md:overflow-visible md:p-0 lg:gap-6">
    {links.map((link) => {
      const label = l(link.label, lang)
      return <a class={navLink} href={`${home}${link.href}`} data-nav-link={link.href} data-label={label}>{label}</a>
    })}
  </nav>
  <LanguageSwitch lang={lang} path={path} />
</header>

<script>
  // Mark the section being read in the navigation, and shrink the logo once the page scrolls.
  const header = document.querySelector<HTMLElement>('[data-site-header]')
  const nav = document.querySelector<HTMLElement>('[data-nav]')
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')]
  const sections = navLinks
    .map(link => ({ hash: link.dataset.navLink!, element: document.getElementById(link.dataset.navLink!.slice(1)) }))
    .filter((section): section is { hash: string; element: HTMLElement } => !!section.element)
    .sort((a, b) => a.element.offsetTop - b.element.offsetTop)

  let frame = 0
  let shown: string | undefined
  function update() {
    frame = 0
    if (header) header.dataset.scrolled = String(window.scrollY > 8)
    if (!sections.length) return
    // A section counts as current once its top passes the upper third of the window.
    const line = window.innerHeight / 3
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2
    const active = atBottom
      ? sections[sections.length - 1]
      : sections.findLast(section => section.element.getBoundingClientRect().top <= line)
    if (active?.hash === shown) return
    shown = active?.hash
    navLinks.forEach(link => {
      if (link.dataset.navLink === shown) link.setAttribute('aria-current', 'location')
      else link.removeAttribute('aria-current')
    })
    // On narrow screens, bring the current tab into view within the sideways-scrolling row.
    const link = navLinks.find(link => link.dataset.navLink === shown)
    if (nav && link && nav.scrollWidth > nav.clientWidth) {
      nav.scrollTo({ left: link.offsetLeft - (nav.clientWidth - link.offsetWidth) / 2, behavior: 'smooth' })
    }
  }
  const schedule = () => { frame ||= requestAnimationFrame(update) }
  window.addEventListener('scroll', schedule, { passive: true })
  window.addEventListener('resize', schedule)
  update()
</script>
