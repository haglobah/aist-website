---
// The link next to an event: it leads to the event's id and copies the link (see scripts/event-links.ts).
// Shown on hover and while the event is the linked one; always on touch screens.
import { useTranslations, type Lang } from '../i18n'

interface Props { id: string; lang: Lang }
const { id, lang } = Astro.props
const t = useTranslations(lang)
---

<a
  href={`#${id}`}
  data-event-link
  data-copied-label={t('linkCopied')}
  aria-label={t('copyEventLink')}
  title={t('copyEventLink')}
  class="action relative -my-2 -mr-2 inline-flex size-10 shrink-0 items-center justify-center text-muted opacity-0 hover:text-accent focus-visible:opacity-100 group-hover:opacity-100 group-data-[linked=true]:opacity-100 data-copied:text-accent data-copied:opacity-100 [@media(hover:none)]:opacity-100"
>
  <svg class="in-data-copied:hidden" width="1.1em" height="1.1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4L11.6 6" />
    <path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4l1.6-1.6" />
  </svg>
  <svg class="hidden in-data-copied:block" width="1.1em" height="1.1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5 12.5l4.5 4.5L19 7.5" />
  </svg>
  <span role="status" class="pointer-events-none absolute right-full top-1/2 mr-1 -translate-y-1/2 whitespace-nowrap bg-ink px-2 py-1 font-sans text-sm text-paper empty:hidden" data-event-link-status></span>
</a>
