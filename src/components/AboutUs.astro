---
import { existsSync } from 'node:fs'
import { advisors, people, volunteers } from '../data/people'
import { l, useTranslations, type Lang } from '../i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)

const groups = [
  { title: t('academicAdvisors'), members: advisors },
  { title: t('volunteers'), members: volunteers },
]
const nameLink = 'underline decoration-rule underline-offset-4 hover:text-accent hover:decoration-accent'

// The ELLIS logo shows once it is uploaded to public/ (any of these names); until then its name stands in.
const ellisLogo = ['ellis-logo.svg', 'ellis-logo.png', 'ellis-logo.webp'].find(file => existsSync(`public/${file}`))

// A photo opens the same profile as the name; that link is hidden from assistive tech to avoid a duplicate.
const initials = (name: string) => name.split(' ').map(part => part[0]).join('')
---

<section id="about-us" aria-labelledby="about-us-heading" class="section-rule">
  <h2 id="about-us-heading" class="font-serif text-4xl md:text-5xl text-balance">{t('aboutUs')}</h2>
  <p class="mt-3 text-muted">{t('aboutUsIntro')}</p>
  <div class="mt-8 grid gap-10 md:grid-cols-2 md:gap-12 lg:grid-cols-3 lg:gap-10">
    {people.map(person => (
      <article class="grid grid-cols-[6rem_1fr] items-start gap-5 sm:grid-cols-[8rem_1fr] sm:gap-6 lg:grid-cols-[6rem_1fr] lg:gap-5">
        {person.image && person.href
          ? <a href={person.href} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true" class="block hover:opacity-85">
              <img src={person.image} alt="" width="400" height="400" loading="lazy" class="aspect-square w-full object-cover outline-1 -outline-offset-1 outline-ink/10" />
            </a>
          : person.image
          ? <img src={person.image} alt={person.name} width="400" height="400" loading="lazy" class="aspect-square w-full object-cover outline-1 -outline-offset-1 outline-ink/10" />
          : <div aria-hidden="true" class="grid aspect-square w-full place-items-center bg-surface font-serif text-2xl text-muted outline-1 -outline-offset-1 outline-ink/10">{initials(person.name)}</div>}
        <div>
          <p class="mb-1 text-sm text-muted">{l(person.role, lang)}</p>
          <h3 class="font-serif text-xl text-balance">
            {person.href
              ? <a href={person.href} target="_blank" rel="noopener noreferrer" class={nameLink}>{person.name}</a>
              : person.name}
          </h3>
          <p class="mt-3 text-pretty">{l(person.bio, lang)}</p>
        </div>
      </article>
    ))}
  </div>
  <div class="mt-10 grid gap-8 sm:grid-cols-2">
    {groups.map(group => (
      <div>
        <h3 class="mb-2 font-serif text-xl text-balance">{group.title}</h3>
        {group.members.length
          ? <ul role="list" class="space-y-1">
              {group.members.map(member => (
                <li>{member.href
                  ? <a href={member.href} target="_blank" rel="noopener noreferrer" class={nameLink}>{member.name}</a>
                  : member.name}</li>
              ))}
            </ul>
          : <p class="text-muted">{t('tba')}</p>}
      </div>
    ))}
  </div>
  <!-- The partner logos have transparent backgrounds; in dark mode Pathfinder's dark lettering is inverted to light. -->
  <div class="mt-8 flex flex-wrap items-center gap-x-10 gap-y-3 text-sm text-muted">
    <span class="basis-full sm:basis-auto">{t('supportedBy')}</span>
    <a href="https://pathfinder.kairos-project.org/" target="_blank" rel="noopener noreferrer" class="block hover:opacity-80">
      <img src={`${import.meta.env.BASE_URL}pathfinder-logo.webp`} alt="Pathfinder" width="265" height="49" loading="lazy" class="h-7 w-auto sm:h-8 dark:invert dark:hue-rotate-180" />
    </a>
    <a href="https://safeaigermany.org/" target="_blank" rel="noopener noreferrer" class="block hover:opacity-80">
      <img src={`${import.meta.env.BASE_URL}saige.webp`} alt="Safe AI Germany (SAIGE)" width="600" height="212" loading="lazy" class="h-11 w-auto sm:h-12 dark:brightness-125" />
    </a>
    <a href="https://institute-tue.ellis.eu/" target="_blank" rel="noopener noreferrer" class="block hover:opacity-80">
      {ellisLogo
        ? <img src={`${import.meta.env.BASE_URL}${ellisLogo}`} alt="ELLIS Institute Tübingen" loading="lazy" class="h-11 w-auto sm:h-12" />
        : <span class="font-serif text-lg text-ink">ELLIS Institute Tübingen</span>}
    </a>
  </div>
</section>
