---
import { getRelativeLocaleUrl } from 'astro:i18n'
import Base from '../layouts/Base.astro'
import SiteHeader from './SiteHeader.astro'
import Arrow from './Arrow.astro'
import SiteFooter from './SiteFooter.astro'
import { kindLabels, photos, withoutPrefix } from '../data/archive'
import { loadPastEvents } from '../data/calendar'
import { parts, site } from '../data/site'
import { l, useTranslations, type Lang } from '../i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)
const path = 'archive/'
const pastEvents = await loadPastEvents()

function formatDate(iso: string) {
  const d = parts(iso, lang)
  return lang === 'de' ? `${d.day}. ${d.month} ${d.year}` : `${d.day} ${d.month} ${d.year}`
}
---

<Base title={`${t('archiveTitle')} · ${site.name}`} lang={lang} path={path} description={t('archiveIntro')}>
  <div class="mx-auto max-w-6xl px-5 pb-16 sm:px-8 lg:px-10">
    <SiteHeader lang={lang} path={path} />

    <main class="pt-10 md:pt-14">
      <a href={getRelativeLocaleUrl(lang)} class="inline-flex min-h-10 items-center gap-2 text-accent underline decoration-accent/40 underline-offset-4 hover:text-ink">
        <Arrow direction="left" /> {t('backHome')}
      </a>
      <h1 class="mt-4 text-balance font-serif text-4xl font-bold md:text-5xl">{t('archiveTitle')}</h1>
      <p class="mt-4 max-w-2xl text-pretty text-lg">{t('archiveIntro')}</p>

      {photos.length > 0 && (
        <section aria-labelledby="photos-heading" class="section-rule">
          <h2 id="photos-heading" class="font-serif text-4xl md:text-5xl">{t('photos')}</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {photos.map((photo) => (
              <figure>
                <img src={`${import.meta.env.BASE_URL}${photo.src}`} alt={l(photo.alt, lang)} loading="lazy" class="aspect-[4/3] w-full object-cover" />
                {photo.caption && <figcaption class="mt-2 text-sm text-muted">{l(photo.caption, lang)}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )}

      <section aria-labelledby="past-events-heading" class="section-rule">
        <h2 id="past-events-heading" class="font-serif text-4xl md:text-5xl">{t('pastEvents')}</h2>
        <ol role="list" class="mt-6 divide-y divide-rule">
          {pastEvents.map((event, index) => (
            <li class="group grid gap-1 py-4 hover:bg-accent/5 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <p class="text-base text-muted tabular-nums">
                <time datetime={event.date}>{formatDate(event.date)}</time>
                <span class="block text-sm">{l(kindLabels[event.kind], lang)}</span>
              </p>
              <div>
                {/* The description opens on hover, or on click/tap via the title. */}
                {event.description ? (
                  <button type="button" data-calendar-toggle aria-expanded="false" aria-controls={`past-details-${index}`} class="block w-full cursor-pointer text-pretty text-left font-serif text-lg leading-snug hover:text-accent aria-expanded:text-accent">{withoutPrefix(event.title)}</button>
                  <div id={`past-details-${index}`} class="reveal mt-1 hidden text-pretty text-base leading-relaxed text-muted group-hover:block group-has-[[aria-expanded=true]]:block [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:pl-6" set:html={event.description} />
                ) : (
                  <p class="text-pretty font-serif text-lg leading-snug">{withoutPrefix(event.title)}</p>
                )}
              </div>
            </li>
          ))}
        </ol>
        {pastEvents.length === 0 && <p class="mt-6 text-pretty text-muted">{t('noPastEvents')}</p>}
      </section>
    </main>
    <SiteFooter lang={lang} />
  </div>
</Base>

<script src="../scripts/event-toggle.ts"></script>
