---
import OuterLink from './OuterLink.astro'
import type { Resource } from '../data/resources'
import { l, type Lang } from '../i18n'
interface Props { links: Resource[]; lang: Lang }
const { links, lang } = Astro.props
---

<ul role="list">
  {links.map(link => (
    <li>
      <OuterLink href={link.href} label={l(link.label, lang)} note={link.note && l(link.note, lang)} />
    </li>
  ))}
</ul>
