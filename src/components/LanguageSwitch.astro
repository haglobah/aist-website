---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { languages, useTranslations, type Lang } from '../i18n'

interface Props { lang: Lang; path?: string }
const { lang, path = '' } = Astro.props
const t = useTranslations(lang)
const other: Lang = lang === 'en' ? 'de' : 'en'
---

<a
  href={getRelativeLocaleUrl(other, path)}
  hreflang={other}
  lang={other}
  title={t('switchLanguage')}
  class="inline-flex min-h-10 items-center gap-1.5 border-l border-rule pl-4 text-ink sm:pl-6 hover:text-accent"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9M12 3c-2.5 2.6-3.8 5.6-3.8 9s1.3 6.4 3.8 9" />
  </svg>
  <span class="text-sm font-bold uppercase tracking-wide" aria-hidden="true">{other}</span>
  <span class="sr-only">{languages[other]}</span>
</a>
