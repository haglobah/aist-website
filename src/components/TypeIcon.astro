---
// Simple stroke glyphs for the four event types. Sized via font-size (1em) and coloured via currentColor.
import type { EventTypeId } from '../data/site'

interface Props {
  type: EventTypeId
  class?: string
  strokeWidth?: number
}

const { type, class: className, strokeWidth = 1.5 } = Astro.props
---

<svg
  class={className}
  width="1em"
  height="1em"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {type === 'lesekreis' && (
    <>
      <path d="M3 5.5C5.5 4.5 8.5 4.5 12 6.5c3.5-2 6.5-2 9-1v13c-2.5-1-5.5-1-9 1-3.5-2-6.5-2-9-1z" />
      <path d="M12 6.5v13" />
    </>
  )}
  {type === 'vortrag' && (
    <>
      <rect x="3" y="4" width="18" height="12" rx="1" />
      <path d="M12 16v4M8 20h8M7 12l3-3 2.5 2L16 8" />
    </>
  )}
  {type === 'workshop' && (
    <>
      <path d="M14.5 4.5a4 4 0 0 0-5 5L4 15l5 5 5.5-5.5a4 4 0 0 0 5-5l-2.5 2.5-2.5-2.5z" />
      <path d="M4 15l5 5" />
    </>
  )}
  {type === 'stammtisch' && (
    <>
      <path d="M5 9h11v7a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4z" />
      <path d="M16 11h2a2 2 0 0 1 0 4h-2M8 5v2M11 4v3M14 5v2" />
    </>
  )}
</svg>
