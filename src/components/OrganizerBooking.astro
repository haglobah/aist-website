---
import { organizers as defaults, type Organizer } from '../data/organizers'
import { bookingTarget } from '../scripts/booking-target'
interface Props { organizers?: Organizer[]; id: string }
const { organizers = defaults, id } = Astro.props
// Invalid configuration should fail the build rather than publish broken or unsafe links.
organizers.forEach(organizer => bookingTarget(organizer.booking, 'localhost'))
---

<organizer-booking>
  <p class="mb-5 max-w-[60ch]">Choose an organizer to chat with. You can switch between people and book a separate call with each.</p>
  <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <div>
      <h3 class="mb-2 text-lg">Who would you like to meet?</h3>
      <ul class="grid gap-2" role="list">
        {organizers.map((organizer) => (
          <li>
            <button type="button" data-organizer={JSON.stringify(organizer)} aria-pressed="false" aria-controls={`${id}-booking`} class="organizer-choice">
              <span class="block text-lg font-bold">{organizer.name}</span>
              <span class="mt-1 block text-sm">{organizer.introduction}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    <section id={`${id}-booking`} aria-label="Booking" class="min-w-0 border border-accent/30">
      <div class="p-5">
        <h3 data-booking-heading class="text-xl">Make time for a conversation</h3>
        <p data-booking-status role="status" class="mt-2">Select someone to see their booking availability.</p>
        <a data-booking-link hidden target="_blank" rel="noopener noreferrer" class="mt-3 inline-block min-h-10 underline decoration-accent underline-offset-4">Open booking page in a new tab ↗</a>
      </div>
      <div data-booking-embed></div>
    </section>
  </div>
</organizer-booking>

<script>
  import '../scripts/organizer-booking'
</script>

<style>
  organizer-booking { display: block; }
  .organizer-choice {
    width: 100%;
    padding: 1rem;
    text-align: left;
    cursor: pointer;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    transition: background-color 150ms ease-out, border-color 150ms ease-out;
  }
  .organizer-choice:hover { background: color-mix(in srgb, var(--color-accent) 6%, transparent); }
  .organizer-choice[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
  [data-booking-embed]:empty { display: none; }
  [data-booking-embed] :global(iframe) { width: 100%; height: 650px; border: 0; background: white; }
  [data-booking-embed] :global(.booking-widget) { min-height: 650px; background: white; }
  @media (prefers-reduced-motion: reduce) { .organizer-choice { transition: none; } }
</style>
