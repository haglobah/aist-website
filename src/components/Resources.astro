---
import ResourceList from './ResourceList.astro'
import { resourceGroups, fellowshipGroups, careerAdvice } from '../data/resources'
---

<section id="resources" aria-labelledby="resources-heading" class="mt-12 scroll-mt-8 border-t border-rule pt-10 md:mt-16">
  <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-12">
    <h2 id="resources-heading" class="font-serif text-3xl text-balance">Resources</h2>
    <p class="max-w-2xl text-pretty text-lg">AI safety has a lot to explore. These starting points can help you find the topics, questions, and perspectives that interest you. This is a curated selection, rather than an exhaustive reading list.</p>
  </div>

  <div class="mt-10 grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
    {resourceGroups.map((group, index) => (
      <div class="border-t border-rule pt-4">
        <div class="mb-3 flex items-baseline gap-3">
          <span aria-hidden="true" class="text-sm text-muted tabular-nums">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="font-serif text-xl text-balance">{group.title}</h3>
        </div>
        <ResourceList links={group.links} />
        {group.note && <p class="mt-3 text-sm text-pretty text-muted">{group.note}</p>}
      </div>
    ))}
  </div>

  <div class="mt-12 bg-sheet p-6 shadow-[0_0_0_1px_var(--color-rule)] sm:p-8">
    <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-12">
      <div>
        <p class="mb-2 text-sm text-accent">Put learning into practice</p>
        <h3 class="font-serif text-2xl">Fellowships</h3>
      </div>
      <p class="text-pretty">Fellowships are a great way to try AI safety work, from technical research to policy and governance. There are full-time and part-time options. Applications can be very competitive, so don’t be discouraged if your first attempt doesn’t work out.</p>
    </div>
    <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {fellowshipGroups.map((group, index) => (
        <div class:list={[index === 4 && 'sm:col-span-2 lg:col-span-4 border-t border-rule pt-6']}>
          <h4 class="mb-2 font-serif text-lg">{group.title}</h4>
          {group.note && <p class="mb-2 text-sm text-muted">{group.note}</p>}
          <div class:list={[index === 4 && 'sm:[&_ul]:grid sm:[&_ul]:grid-cols-2 sm:[&_ul]:gap-x-10 sm:[&_li]:border-0 lg:[&_ul]:grid-cols-3']}>
            <ResourceList links={group.links} />
          </div>
        </div>
      ))}
    </div>
    <div class="mt-7 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-rule pt-6">
      <p class="text-pretty text-muted">Unsure which fellowship fits? We’re happy to help you find your way.</p>
      <a href="#feedback" data-feedback-open class="inline-flex min-h-11 items-center gap-3 text-accent underline decoration-accent/40 underline-offset-4 hover:text-ink">Ask us for advice <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <aside class="mt-8 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-y border-rule py-5">
    <div>
      <h3 class="font-serif text-xl">Thinking about your career?</h3>
      <p class="mt-1 text-muted">Explore ways to make AI safety part of your work.</p>
    </div>
    <a href={careerAdvice.href} class="inline-flex min-h-11 items-center gap-3 text-accent underline decoration-accent/40 underline-offset-4 hover:text-ink">{careerAdvice.label} <span aria-hidden="true">↗</span></a>
  </aside>
</section>
