---
import ResourceList from './ResourceList.astro'
import { resourceGroups, fellowshipGroups } from '../data/resources'
import { l, useTranslations, type Lang } from '../i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)

const groupClass = 'relative isolate p-4 before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:bg-paper before:opacity-0 before:blur-[8px] before:content-[\'\'] hover:before:opacity-100 motion-safe:before:transition-opacity'
const groupGrid = 'mt-6 -mx-4 grid gap-x-10 gap-y-2 sm:grid-cols-2 lg:grid-cols-3'
---

<section id="resources" aria-labelledby="resources-heading" class="section-rule">
  <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-12">
    <h2 id="resources-heading" class="font-serif text-3xl text-balance">{t('resources')}</h2>
    <p class="max-w-2xl text-pretty text-lg">{t('resourcesIntro')}</p>
  </div>

  <div class={groupGrid}>
    {resourceGroups.map((group, index) => (
      <div class={groupClass}>
        <div class="mb-2 flex items-baseline gap-3">
          <span aria-hidden="true" class="text-sm text-muted tabular-nums">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="font-serif text-xl text-balance">{l(group.title, lang)}</h3>
        </div>
        <ResourceList links={group.links} lang={lang} />
        {group.note && <p class="mt-2 text-sm text-pretty text-muted">{l(group.note, lang)}</p>}
      </div>
    ))}
  </div>
</section>

<section id="fellowships" aria-labelledby="fellowships-heading" class="section-rule">
  <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-12">
    <h2 id="fellowships-heading" class="font-serif text-3xl text-balance">{t('fellowships')}</h2>
    <p class="max-w-2xl text-pretty">{t('fellowshipsIntro')}</p>
  </div>
  <div class={groupGrid}>
    {fellowshipGroups.map(group => (
      <div class={groupClass}>
        <h3 class="mb-2 font-serif text-xl text-balance">{l(group.title, lang)}</h3>
        {group.note && <p class="mb-2 text-sm text-muted">{l(group.note, lang)}</p>}
        <ResourceList links={group.links} lang={lang} />
      </div>
    ))}
  </div>
</section>
