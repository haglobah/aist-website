---
// Stroke glyphs for the social channels, matching TypeIcon. Sized via font-size (1em) and coloured via currentColor.
import type { SocialId } from '../data/site'

interface Props { id: SocialId }
const { id } = Astro.props
---

<svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {id === 'whatsapp' && <>
    <path d="M4 20l1.2-3.8A8.5 8.5 0 1 1 8 19z" />
    <path d="M9 8.3c-.2 3.4 3.2 6.8 6.6 6.6l.9-1.6-2.1-1-1 .9c-1.3-.5-2.4-1.6-2.9-2.9l.9-1-1-2.1z" />
  </>}
  {id === 'linkedin' && <>
    <rect x="3" y="3" width="18" height="18" rx="3" />
    <path d="M8 10.5V17M12 17v-6.5M12 13.5a2.5 2.5 0 0 1 5 0V17" />
    <circle cx="8" cy="7.3" r=".6" fill="currentColor" />
  </>}
  {id === 'instagram' && <>
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.3" cy="6.7" r=".6" fill="currentColor" />
  </>}
</svg>
