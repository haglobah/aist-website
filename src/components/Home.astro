---
import { getRelativeLocaleUrl } from 'astro:i18n'
import Base from '../layouts/Base.astro'
import Arrow from './Arrow.astro'
import CoffeeChat from './CoffeeChat.astro'
import Feedback from './Feedback.astro'
import AboutUs from './AboutUs.astro'
import Resources from './Resources.astro'
import SiteHeader from './SiteHeader.astro'
import SiteFooter from './SiteFooter.astro'
import Emphasis from './Emphasis.astro'
import SocialIcon from './SocialIcon.astro'
import { resolveCalendar, eventTypes, hangout, hero, parts, site, socials } from '../data/site'
import { people } from '../data/people'
import { l, useTranslations, type Lang } from '../i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)

const pillButton = 'mt-4 inline-flex min-h-11 cursor-pointer items-center justify-center rounded-full border border-ink px-5 py-2 text-base text-ink hover:bg-ink/5'
const disclosureSummary = 'action -mx-3 flex cursor-pointer list-none items-center justify-between gap-4 rounded-lg px-3 py-3 hover:bg-surface [&::-webkit-details-marker]:hidden'
const accentLink = 'text-accent underline decoration-accent/40 underline-offset-4 hover:text-ink hover:decoration-accent'
---

<Base title={site.name} lang={lang}>
  <div class="pointer-events-none fixed inset-0 -z-10 grid place-items-center" aria-hidden="true">
    <img class="w-[min(88vw,64rem)] opacity-10 dark:opacity-[0.07] dark:invert" src={`${import.meta.env.BASE_URL}stocherkahn.webp`} width="1400" height="933" alt="" />
  </div>
  <div class="mx-auto max-w-6xl px-5 pb-16 sm:px-8 lg:px-10">
    <SiteHeader lang={lang} />

    <section class="grid gap-12 pt-10 md:grid-cols-2 md:gap-x-16 md:pt-14">
      <h1 class="text-balance max-w-4xl font-serif text-4xl leading-tight font-bold md:col-span-2 md:text-5xl md:leading-tight">{l(hero.heading, lang)}</h1>
      <div id="about" class="max-w-xl text-lg leading-relaxed text-ink">
        <p class="text-pretty">{l(hero.text, lang)}</p>
        <p class="text-pretty mt-5">{l(hero.listIntro, lang)}</p>
        <ul class="mt-2 list-disc space-y-1 pl-6 marker:text-accent">
          {hero.points.map((point) => <li class="text-pretty"><Emphasis text={l(point, lang)} /></li>)}
        </ul>
        <p class="text-pretty mt-5">{l(hero.closing, lang)}</p>
      </div>
      <aside id="contact" aria-labelledby="hangout-heading" class="flex scroll-mt-4 flex-col border-t border-rule pt-8 md:border-t-0 md:border-l md:pt-0 md:pl-8">
        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
          <h2 id="hangout-heading" class="text-balance font-serif text-2xl">{l(hangout.heading, lang)}</h2>
          <a href="#about-us" class="flex -space-x-2 rounded-full" title={people.map(person => person.name).join(', ')}>
            {people.filter(person => person.image).map(person => (
              <img src={person.image} alt={person.name} width="40" height="40" loading="lazy" class="size-10 rounded-full object-cover ring-2 ring-paper" />
            ))}
          </a>
        </div>
        <!-- Rows share the column height so the block lines up with the introduction; the arrows fold out details. -->
        <div class="mt-3 flex flex-1 flex-col divide-y divide-rule text-lg leading-snug">
          <details name="hangout" class="group flex flex-1 flex-col justify-center py-3">
            <summary class={disclosureSummary}>
              <span class="text-pretty"><Emphasis text={l(hangout.contact, lang)} /></span>
              <Arrow direction="down" class="text-xl text-accent group-open:-rotate-90 motion-safe:transition-transform" />
            </summary>
            <div class="pt-2 pb-3 text-base leading-relaxed">
              <p class="text-pretty">{t('contactText')}</p>
              <button type="button" data-feedback-open aria-haspopup="dialog" aria-controls="feedback-modal" class={pillButton}>{t('contactButton')}</button>
            </div>
          </details>
          <div class="flex flex-1 flex-wrap items-center justify-between gap-x-4 gap-y-3 py-3">
            <span><Emphasis text={l(hangout.stayUpToDate, lang)} /></span>
            <span class="flex gap-2">
              {socials.map((social) => social.href
                ? <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} title={social.label} class="action grid size-11 place-items-center rounded-full border border-rule text-2xl text-ink hover:border-accent hover:text-accent"><SocialIcon id={social.id} /></a>
                : <span role="img" aria-label={`${social.label} (${t('linkComingSoon')})`} title={`${social.label} (${t('linkComingSoon')})`} class="grid size-11 place-items-center rounded-full border border-dashed border-rule text-2xl text-muted/60"><SocialIcon id={social.id} /></span>)}
            </span>
          </div>
          <details name="hangout" class="group flex flex-1 flex-col justify-center py-3">
            <summary class={disclosureSummary}>
              <span class="text-pretty"><Emphasis text={l(hangout.coffee, lang)} /></span>
              <Arrow direction="down" class="text-xl text-accent group-open:-rotate-90 motion-safe:transition-transform" />
            </summary>
            <div class="pt-2 pb-3 text-base leading-relaxed">
              <p class="text-pretty">{t('coffeeText')}</p>
              <button type="button" data-modal-open="coffee-modal" aria-haspopup="dialog" aria-controls="coffee-modal" class={pillButton}>{t('coffeeButton')}</button>
            </div>
          </details>
        </div>
      </aside>
    </section>

    <section id="events" class="section-rule grid items-start gap-10 md:grid-cols-2 md:gap-x-12">
      <div>
        <h2 class="text-balance sr-only">{t('eventTypes')}</h2>
        <ul role="list" data-filter-group class="divide-y divide-rule">
          {eventTypes.map((type) => (
            <li
              class="activity relative isolate py-3 px-6 data-[highlighted=true]:bg-highlight [&_a]:relative [&_a]:z-1"
              data-filter-card={type.id}
            >
              <h3 class="text-balance">
                <button
                  type="button"
                  class="activity-filter after:absolute after:inset-0 after:content-[''] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-3 focus-visible:after:outline-accent flex min-h-11 w-full cursor-pointer items-center gap-3 text-left aria-pressed:text-accent"
                  data-filter={type.id}
                  aria-pressed="false"
                  aria-controls="calendar-events"
                  title={t('filterHint')}
                >
                  <span class="activity-title font-serif text-xl">{l(type.name, lang)}</span>
                </button>
              </h3>
              <div class="mt-2 text-base leading-relaxed">
                {type.schedule && <p class="text-pretty mb-2 text-base text-muted">{l(type.schedule.dayLabel, lang)} {type.schedule.time} | {l(type.schedule.place, lang)} | {l(type.schedule.language, lang)}</p>}
                {type.info && <p class="text-pretty mb-2 text-base text-muted">{l(type.info, lang)}</p>}
                <p class="text-pretty">{l(type.description, lang)}</p>
                {type.archive && (
                  <p class="mt-2 text-base">
                    <a class={`${accentLink} inline-flex min-h-10 items-center gap-2`} href={getRelativeLocaleUrl(lang, 'archive/')}>{t('archiveLink')} <Arrow direction="right" /></a>
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>

      <aside class="border border-rule bg-sheet" id="calendar">
        <ol role="list" id="calendar-events" data-filter-target aria-live="polite">
          {resolveCalendar().map((e) => {
            const d = parts(e.date, lang)
            return (
              <li class="calendar-event group data-[highlighted=true]:bg-highlight grid grid-cols-5 gap-3 py-4 px-7 hover:bg-accent/5" data-event-type={e.type} data-calendar-index={e.index}>
                <time class="col-span-1 text-base leading-relaxed text-muted tabular-nums" datetime={e.date}>
                  <b class="block font-bold text-ink">{d.weekday} {d.day}</b> <span data-calendar-month>{d.monthShort}</span>
                  <span class="block" data-calendar-time>{e.time}</span>
                </time>
                <div class="col-span-4">
                  <!-- The description opens on hover, or on click/tap via the title. -->
                  <button type="button" data-calendar-toggle aria-expanded="false" aria-controls={`calendar-details-${e.index}`} class="block w-full cursor-pointer text-left font-serif text-lg leading-snug hover:text-accent aria-expanded:text-accent">{l(e.title, lang)}</button>
                  <p class="mt-1 text-base text-muted">{l(e.place, lang)}</p>
                  {e.registerUrl
                    ? <a href={e.registerUrl} target="_blank" rel="noopener noreferrer" class={`${accentLink} inline-flex min-h-10 items-center gap-2`}>{t('register')} <Arrow direction="up-right" /></a>
                    : <p class="text-base text-muted">{t('registrationSoon')}</p>}
                  <div id={`calendar-details-${e.index}`} class="mt-2 hidden text-base leading-relaxed group-hover:block group-has-[[aria-expanded=true]]:block">
                    <p class="text-pretty">{l(e.description, lang)}</p>
                  </div>
                </div>
              </li>
            )
          })}
        </ol>
        <p class="text-pretty py-6 text-muted" data-filter-empty hidden>
          {t('noEvents')}
        </p>
      </aside>
    </section>

    <AboutUs lang={lang} />
    <Resources lang={lang} />

    <SiteFooter lang={lang} />
    <Feedback lang={lang} />
    <CoffeeChat lang={lang} />
  </div>
</Base>

<script src="../scripts/filter.ts"></script>

<script src="../scripts/calendar.ts"></script>
