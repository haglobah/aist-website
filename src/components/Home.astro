---
import { getRelativeLocaleUrl } from 'astro:i18n'
import Base from '../layouts/Base.astro'
import Arrow from './Arrow.astro'
import ContactForm from './ContactForm.astro'
import AboutUs from './AboutUs.astro'
import Gallery from './Gallery.astro'
import Resources from './Resources.astro'
import SiteHeader from './SiteHeader.astro'
import SiteFooter from './SiteFooter.astro'
import Emphasis from './Emphasis.astro'
import SocialIcon from './SocialIcon.astro'
import { eventTypes, hangout, hero, parts, registerUrl, site, socials } from '../data/site'
import { loadCalendar } from '../data/calendar'
import { people } from '../data/people'
import { l, useTranslations, type Lang } from '../i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)
const events = await loadCalendar()

const pillButton = 'mt-4 inline-flex min-h-11 cursor-pointer items-center justify-center border border-ink px-5 py-2 text-base text-ink hover:bg-ink/5'
const disclosureSummary = 'action -mx-3 flex cursor-pointer list-none items-center justify-between gap-4 px-3 py-3 hover:bg-surface [&::-webkit-details-marker]:hidden'
const subheading = 'mb-4 font-serif text-2xl text-balance'
const accentLink = 'text-accent underline decoration-accent/40 underline-offset-4 hover:text-ink hover:decoration-accent'
---

<Base title={site.name} lang={lang}>
  <div class="mx-auto max-w-6xl px-5 pb-16 sm:px-8 lg:px-10">
    <SiteHeader lang={lang} />

    <!-- The introduction takes three fifths of the width, the contact block two fifths. -->
    <section class="grid gap-12 pt-10 md:grid-cols-5 md:gap-x-16 md:pt-14">
      <h1 class="text-balance max-w-4xl font-serif text-4xl leading-tight font-bold md:col-span-5 md:text-5xl md:leading-tight">{l(hero.heading, lang)}</h1>
      <div id="about" class="text-lg leading-relaxed text-ink md:col-span-3">
        <p class="text-pretty">{l(hero.text, lang)}</p>
        <p class="text-pretty mt-5">{l(hero.listIntro, lang)}</p>
        <ul class="mt-2 list-disc space-y-1 pl-6 marker:text-accent">
          {hero.points.map((point) => <li class="text-pretty"><Emphasis text={l(point, lang)} /></li>)}
        </ul>
        <p class="text-pretty mt-5">{l(hero.closing, lang)}</p>
      </div>
      <aside id="contact" aria-labelledby="hangout-heading" class="flex scroll-mt-40 flex-col border-t border-rule pt-8 md:col-span-2 md:scroll-mt-28 md:border-t-0 md:border-l md:pt-0 md:pl-8">
        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
          <h2 id="hangout-heading" class="text-balance font-serif text-3xl md:text-4xl">{l(hangout.heading, lang)}</h2>
          <a href="#about-us" class="flex -space-x-2 rounded-full" title={people.map(person => person.name).join(', ')}>
            {people.filter(person => person.image).map(person => (
              <img src={person.image} alt={person.name} width="40" height="40" loading="lazy" class="size-10 rounded-full object-cover ring-2 ring-paper" />
            ))}
          </a>
        </div>
        <!-- Rows share the column height so the block lines up with the introduction; the arrows fold out details. -->
        <div class="mt-3 flex flex-1 flex-col divide-y divide-rule text-lg leading-snug">
          <details name="hangout" class="group flex flex-1 flex-col justify-center py-3">
            <summary class={disclosureSummary}>
              <span class="text-pretty"><Emphasis text={l(hangout.contact, lang)} /></span>
              <Arrow direction="down" class="text-xl text-accent group-open:-rotate-90 motion-safe:transition-transform" />
            </summary>
            <div class="pt-2 pb-3 text-base leading-relaxed">
              <p class="mb-4 text-pretty">{t('contactText')}</p>
              <ContactForm id="feedback" lang={lang} subject="Website: feedback / suggestion" />
            </div>
          </details>
          <div class="flex flex-1 flex-wrap items-center justify-between gap-x-4 gap-y-3 py-3">
            <span><Emphasis text={l(hangout.stayUpToDate, lang)} /></span>
            <span class="flex gap-2">
              {socials.map((social) => social.href
                ? <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} title={social.label} class="action grid size-11 place-items-center border border-rule text-2xl text-ink hover:border-accent hover:text-accent"><SocialIcon id={social.id} /></a>
                : <span role="img" aria-label={`${social.label} (${t('linkComingSoon')})`} title={`${social.label} (${t('linkComingSoon')})`} class="grid size-11 place-items-center border border-dashed border-rule text-2xl text-muted/60"><SocialIcon id={social.id} /></span>)}
            </span>
          </div>
          <details name="hangout" class="group flex flex-1 flex-col justify-center py-3">
            <summary class={disclosureSummary}>
              <span class="text-pretty"><Emphasis text={l(hangout.coffee, lang)} /></span>
              <Arrow direction="down" class="text-xl text-accent group-open:-rotate-90 motion-safe:transition-transform" />
            </summary>
            <div class="pt-2 pb-3 text-base leading-relaxed">
              <p class="mb-4 text-pretty">{t('coffeeText')}</p>
              <ContactForm id="coffee" lang={lang} subject="Website: 1:1 career chat request" emailRequired />
            </div>
          </details>
        </div>
      </aside>
    </section>

    <section id="events" aria-labelledby="events-heading" class="section-rule grid items-start gap-10 md:grid-cols-2 md:gap-x-12">
      <h2 id="events-heading" class="font-serif text-4xl text-balance md:col-span-2 md:text-5xl">{t('nextEvents')}</h2>
      <div>
        <h3 class={subheading}>{t('eventTypes')}</h3>
        <ul role="list" data-filter-group data-calendar-limit class="divide-y divide-rule">
          {eventTypes.map((type) => (
            <li
              class="activity relative isolate py-3 px-6 data-[highlighted=true]:bg-highlight [&_a]:relative [&_a]:z-1"
              data-filter-card={type.id}
            >
              <h4 class="text-balance">
                <button
                  type="button"
                  class="activity-filter after:absolute after:inset-0 after:content-[''] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-3 focus-visible:after:outline-accent flex min-h-11 w-full cursor-pointer items-center gap-3 text-left aria-pressed:text-accent"
                  data-filter={type.id}
                  aria-pressed="false"
                  aria-controls="calendar-events"
                  title={t('filterHint')}
                >
                  <span class="activity-title font-serif text-xl">{l(type.name, lang)}</span>
                </button>
              </h4>
              <div class="mt-2 text-base leading-relaxed">
                {type.schedule && <p class="text-pretty mb-2 text-base text-muted">{l(type.schedule.dayLabel, lang)} {type.schedule.time} | {l(type.schedule.place, lang)} | {l(type.schedule.language, lang)}</p>}
                {type.info && <p class="text-pretty mb-2 text-base text-muted">{l(type.info, lang)}</p>}
                <p class="text-pretty">{l(type.description, lang)}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div>
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h3 class="font-serif text-2xl text-balance">{t('calendar')}</h3>
        <a href={registerUrl} target="_blank" rel="noopener noreferrer" class="action inline-flex min-h-11 items-center gap-2 border border-accent bg-accent px-5 py-2 text-base text-paper hover:border-ink hover:bg-ink">{t('registerForEvents')} <Arrow direction="up-right" /></a>
      </div>
      <aside class="border border-rule bg-sheet" id="calendar">
        <!-- Filled from the Google Calendar at build time; past events are removed in the browser.
             The list scrolls once it is longer than ten events or than the event types beside it. -->
        <ol role="list" id="calendar-events" data-filter-target aria-live="polite" class="thin-scrollbar overflow-y-auto overscroll-contain">
          {events.map((e, index) => {
            const d = parts(e.date, lang)
            return (
              <li class="calendar-event group data-[highlighted=true]:bg-highlight grid grid-cols-5 gap-3 py-4 px-7 hover:bg-accent/5" data-event-type={e.type} data-calendar-end={e.end}>
                <time class="col-span-1 text-base leading-relaxed text-muted tabular-nums" datetime={e.date}>
                  <b class="block font-bold text-ink">{d.weekday} {d.day}</b> {d.monthShort}
                  {e.time && <span class="block">{e.time}</span>}
                </time>
                <div class="col-span-4">
                  <!-- The description opens on hover, or on click/tap via the title. -->
                  <button type="button" data-calendar-toggle aria-expanded="false" aria-controls={`calendar-details-${index}`} class="block w-full cursor-pointer text-left font-serif text-lg leading-snug hover:text-accent aria-expanded:text-accent">{e.title}</button>
                  {e.place && <p class="mt-1 text-base text-muted">{e.place}</p>}
                  {e.registerUrl && <a href={e.registerUrl} target="_blank" rel="noopener noreferrer" class={`${accentLink} inline-flex min-h-10 items-center gap-2`}>{t('register')} <Arrow direction="up-right" /></a>}
                  <div id={`calendar-details-${index}`} class="reveal mt-2 hidden text-base leading-relaxed group-hover:block group-has-[[aria-expanded=true]]:block [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:pl-6">
                    <div class="text-pretty" set:html={e.description} />
                  </div>
                </div>
              </li>
            )
          })}
        </ol>
        <p class="text-pretty px-7 py-6 text-muted" data-filter-empty hidden={events.length > 0}>
          {t('noEvents')}
        </p>
      </aside>
      <a href={getRelativeLocaleUrl(lang, 'archive/')} class={`${pillButton} gap-2`}>{t('pastEvents')} <Arrow direction="right" /></a>
      </div>
    </section>

    <Gallery lang={lang} />
    <AboutUs lang={lang} />
    <Resources lang={lang} />

    <SiteFooter lang={lang} />
  </div>
</Base>

<script src="../scripts/filter.ts"></script>

<script src="../scripts/calendar.ts"></script>
