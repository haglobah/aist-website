---
// Stroke arrow in the style of the other icons. Sized via font-size (1em) and coloured via currentColor.
interface Props {
  direction: 'right' | 'down' | 'left' | 'up-right'
  class?: string
}
const { direction, class: className } = Astro.props
const rotation = { right: '', down: 'rotate-90', left: 'rotate-180', 'up-right': '-rotate-45' }[direction]
---

<svg class:list={['shrink-0', rotation, className]} width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M5 12h14M13 6l6 6-6 6" />
</svg>
