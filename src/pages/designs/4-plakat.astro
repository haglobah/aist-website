---
import Base from '../../layouts/Base.astro'
import TypeIcon from '../../components/TypeIcon.astro'
import { calendar, contact, eventTypes, hangout, hero, links, parts, site, typeById } from '../../data/site'
---

<Base title={`${site.name}: Plakat`} design={4}>
  <div class="page">
    <header class="hero" id="was">
      <h1>{hero.heading}</h1>
      <div class="hero-row">
        <p class="brand">{site.name}<br /><span>{site.tagline}</span></p>
        <p class="lede">{hero.text}</p>
      </div>
    </header>

    <nav class="links" aria-label="Mehr">
      <ul role="list">
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
            <span>{l.note}</span>
          </li>
        ))}
      </ul>
    </nav>

    <aside class="hang">
      <h2>{hangout.heading}</h2>
      <p>{hangout.text}</p>
      <p class="actions">
        {hangout.actions.map((a) => <a href={a.href}>{a.label}</a>)}
      </p>
    </aside>

    <div class="filter" data-filter-group>
      <span>Zeig mir</span>
      <button data-filter="all" aria-pressed="true">alles</button>
      {eventTypes.map((t) => <button data-filter={t.id}>{t.name}</button>)}
    </div>

    <section class="types" id="formate">
      <ul role="list" data-filter-target>
        {eventTypes.map((t) => (
          <li class="type" data-event-type={t.id}>
            <span class="icon"><TypeIcon type={t.id} strokeWidth={1} /></span>
            <h3>{t.name}</h3>
            <p class="rhythm">{t.rhythm}</p>
            <p>{t.description}</p>
            <p class="type-links">
              <a href={t.foodUrl}>Essen abstimmen</a>
              <a href={t.feedbackUrl}>Feedback geben</a>
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class="cal" id="kalender">
      <h2>Kalender <em>wo, was, wann</em></h2>
      <table>
        <thead class="visually-hidden">
          <tr><th>Datum</th><th>Was</th><th>Typ</th><th>Wo</th></tr>
        </thead>
        <tbody data-filter-target>
          {calendar.map((e) => {
            const d = parts(e.date)
            return (
              <tr data-event-type={e.type}>
                <td class="date">
                  <time datetime={e.date}>
                    <b>{d.dayPadded}.{d.monthPadded}.</b> {d.weekday}, {e.time} Uhr
                  </time>
                </td>
                <td class="what">{e.title}</td>
                <td class="kind">{typeById(e.type).name}</td>
                <td class="where">{e.place}</td>
              </tr>
            )
          })}
        </tbody>
      </table>
      <p data-filter-empty hidden>Für diesen Typ steht gerade nichts im Kalender.</p>
    </section>

    <footer class="contact" id="kontakt">
      <h2>{contact.heading}</h2>
      <p class="contact-text">{contact.text}</p>
      <ul role="list" class="socials">
        {contact.socials.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </footer>
  </div>
</Base>

<script src="../../scripts/filter.ts"></script>

<style>
  .page {
    --bg: #f5f3ee;
    --ink: #141414;
    --accent: #6b1f2a;
    --muted: #6e6a66;
    max-width: 92rem;
    margin-inline: auto;
    padding: 1rem clamp(1.25rem, 3vw, 3rem) 7rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  a {
    text-underline-offset: 0.15em;
  }

  .hero h1 {
    font-size: clamp(3.4rem, 13.5vw, 13rem);
    font-style: italic;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 1rem 0 0 -0.04em;
    color: var(--accent);
  }
  .hero-row {
    display: grid;
    grid-template-columns: 1fr minmax(0, 40rem);
    gap: 2rem;
    align-items: end;
    padding-block: 2rem 2.5rem;
  }
  .brand {
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }
  .brand span {
    font-weight: 400;
    font-size: 1rem;
    letter-spacing: 0;
    color: var(--muted);
  }
  .lede {
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    line-height: 1.4;
  }

  .links ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 3px solid var(--ink);
  }
  .links li {
    padding: 1rem 1.25rem 1.25rem 0;
    border-right: 1px solid var(--ink);
  }
  .links li + li {
    padding-left: 1.25rem;
  }
  .links li:last-child {
    border-right: 0;
  }
  .links a {
    display: block;
    font-size: clamp(1.4rem, 2.4vw, 2.2rem);
    line-height: 1.15;
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .links span {
    color: var(--muted);
  }

  .hang {
    margin-top: 3rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--accent);
    color: #f5f3ee;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) auto;
    gap: 2rem;
    align-items: center;
  }
  .hang h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1;
  }
  .hang p {
    font-size: 1.1rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .actions a {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border: 2px solid #f5f3ee;
    text-decoration: none;
    white-space: nowrap;
  }
  .actions a:first-child {
    background: #f5f3ee;
    color: var(--accent);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-top: 4rem;
    padding-bottom: 0.75rem;
    border-bottom: 3px solid var(--ink);
    font-size: clamp(1.3rem, 2.4vw, 2rem);
  }
  .filter span {
    color: var(--muted);
  }
  .filter button {
    background: none;
    border: 0;
    padding: 0;
    color: var(--muted);
  }
  .filter button:hover {
    color: var(--ink);
  }
  .filter button[aria-pressed='true'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--accent);
  }

  .types ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .type {
    padding: 1.5rem 1.5rem 2rem 0;
    border-right: 1px solid var(--ink);
  }
  .type + .type {
    padding-left: 1.5rem;
  }
  .type:last-child {
    border-right: 0;
  }
  .icon {
    display: block;
    width: fit-content;
    font-size: 3.5rem;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .type h3 {
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    font-weight: 400;
    line-height: 1.1;
  }
  .rhythm {
    color: var(--muted);
    margin: 0.35rem 0 0.75rem;
  }
  .type-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 1rem;
  }
  .type-links a {
    color: var(--accent);
  }

  .cal {
    margin-top: 4rem;
    border-top: 3px solid var(--ink);
    padding-top: 1rem;
  }
  .cal h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .cal h2 em {
    font-weight: 400;
    color: var(--muted);
    margin-left: 0.5rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  td {
    padding: 0.9rem 1rem 0.9rem 0;
    border-top: 1px solid var(--ink);
    vertical-align: baseline;
  }
  tr:last-child td {
    border-bottom: 1px solid var(--ink);
  }
  .date {
    white-space: nowrap;
    width: 1%;
    color: var(--muted);
  }
  .date b {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 400;
    color: var(--ink);
    margin-right: 0.5rem;
  }
  .what {
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
  }
  .kind {
    color: var(--accent);
    white-space: nowrap;
  }
  .where {
    color: var(--muted);
    text-align: right;
    padding-right: 0;
  }
  [data-filter-empty] {
    padding: 1rem 0;
    border-bottom: 1px solid var(--ink);
    color: var(--muted);
    font-style: italic;
  }

  .contact {
    margin-top: 5rem;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1rem 3rem;
  }
  .contact h2 {
    grid-column: 1 / -1;
    font-size: clamp(3rem, 9vw, 8rem);
    font-style: italic;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--accent);
    margin-left: -0.04em;
  }
  .contact-text {
    font-size: 1.2rem;
    max-width: 45ch;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    font-size: 1.2rem;
  }

  @media (max-width: 64rem) {
    .types ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .type:nth-child(2) {
      border-right: 0;
    }
    .type:nth-child(n + 3) {
      border-top: 1px solid var(--ink);
    }
    .hang {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
  @media (max-width: 48rem) {
    .hero-row, .links ul, .contact {
      grid-template-columns: 1fr;
    }
    .links li {
      border-right: 0;
      border-bottom: 1px solid var(--ink);
      padding-left: 0 !important;
    }
    .links li:last-child {
      border-bottom: 0;
    }
    .kind, .where {
      display: none;
    }
  }
  @media (max-width: 36rem) {
    .types ul {
      grid-template-columns: 1fr;
    }
    .type {
      border-right: 0;
      padding-left: 0 !important;
    }
    .type:nth-child(n + 2) {
      border-top: 1px solid var(--ink);
    }
    td {
      display: block;
      border: 0;
      padding: 0.15rem 0;
    }
    tr td:first-child {
      border-top: 1px solid var(--ink);
      padding-top: 0.9rem;
    }
    tr td:last-child {
      padding-bottom: 0.9rem;
    }
    tr:last-child td:last-child {
      border-bottom: 1px solid var(--ink);
    }
  }
</style>
