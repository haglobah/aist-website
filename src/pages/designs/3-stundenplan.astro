---
import Base from '../../layouts/Base.astro'
import TypeIcon from '../../components/TypeIcon.astro'
import { calendar, contact, eventTypes, hangout, hero, links, parts, site, typeById } from '../../data/site'

// Build month grids for every month that has an entry.
const monthKeys = Array.from(new Set(calendar.map((e) => e.date.slice(0, 7))))
const months = monthKeys.map((key) => {
  const [y, m] = key.split('-').map(Number)
  const first = new Date(y, m - 1, 1)
  const daysInMonth = new Date(y, m, 0).getDate()
  const offset = (first.getDay() + 6) % 7 // Monday first
  const label = parts(`${key}-01`).month + ' ' + y
  const cells = []
  for (let i = 0; i < offset; i++) cells.push(null)
  for (let d = 1; d <= daysInMonth; d++) {
    const iso = `${key}-${String(d).padStart(2, '0')}`
    cells.push({ day: d, iso, events: calendar.filter((e) => e.date === iso) })
  }
  return { key, label, cells }
})
const weekdays = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So']
---

<Base title={`${site.name}: Stundenplan`} design={3}>
  <div class="page">
    <header class="top">
      <div>
        <p class="brand">{site.name}</p>
        <h1>{hero.heading}</h1>
        <p class="lede">{hero.text}</p>
      </div>
      <nav class="links" aria-label="Mehr">
        <ul role="list">
          {links.map((l) => (
            <li><a href={l.href}>{l.label}</a><span>{l.note}</span></li>
          ))}
        </ul>
      </nav>
    </header>

    <section class="calendar" id="kalender">
      <div class="cal-bar">
        <h2>Kalender</h2>
        <div class="legend" data-filter-group role="group" aria-label="Filter nach Event-Typ">
          <button data-filter="all" aria-pressed="true">Alle Termine</button>
          {eventTypes.map((t) => (
            <button data-filter={t.id} class={`t-${t.id}`}><i></i>{t.name}</button>
          ))}
        </div>
      </div>

      <div class="months" data-filter-target>
        {months.map((mo) => (
          <div class="month">
            <h3>{mo.label}</h3>
            <div class="grid" role="list">
              {weekdays.map((w) => <span class="wd">{w}</span>)}
              {mo.cells.map((c) =>
                c === null ? (
                  <span class="cell pad"></span>
                ) : (
                  <div class={`cell${c.events.length ? ' has' : ''}`} role="listitem">
                    <span class="n">{c.day}</span>
                    {c.events.map((e) => (
                      <a class={`ev t-${e.type}`} href="#kalender" data-event-type={e.type} title={`${e.title}, ${e.time} Uhr, ${e.place}`}>
                        <span class="ev-time">{e.time}</span>
                        <span class="ev-title">{typeById(e.type).name}</span>
                      </a>
                    ))}
                  </div>
                ),
              )}
            </div>
          </div>
        ))}
      </div>

      <ol class="list" role="list" data-filter-target>
        {calendar.map((e) => {
          const d = parts(e.date)
          return (
            <li class={`t-${e.type}`} data-event-type={e.type}>
              <i></i>
              <time datetime={e.date}>{d.weekday} {d.day}. {d.monthShort}, {e.time} Uhr</time>
              <span>{e.title}</span>
              <span class="place">{e.place}</span>
            </li>
          )
        })}
      </ol>
    </section>

    <section class="types" id="formate">
      <ul role="list">
        {eventTypes.map((t) => (
          <li class={`type t-${t.id}`}>
            <span class="swatch"><TypeIcon type={t.id} /></span>
            <h3>{t.name}</h3>
            <p class="rhythm">{t.rhythm}</p>
            <p>{t.description}</p>
            <p class="type-links">
              <a href={t.foodUrl}>Essen abstimmen</a>
              <a href={t.feedbackUrl}>Feedback geben</a>
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class="bottom">
      <aside class="hang">
        <h2>{hangout.heading}</h2>
        <p>{hangout.text}</p>
        <p class="actions">
          {hangout.actions.map((a) => <a href={a.href}>{a.label}</a>)}
        </p>
      </aside>
      <footer class="contact" id="kontakt">
        <h2>{contact.heading}</h2>
        <p>{contact.text}</p>
        <ul role="list" class="socials">
          {contact.socials.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
        </ul>
      </footer>
    </section>
  </div>
</Base>

<script src="../../scripts/filter.ts"></script>

<style>
  .page {
    --bg: #f7f7f3;
    --ink: #1e1f1c;
    --muted: #71736b;
    --rule: #d6d7cf;
    --accent: #1e1f1c;
    --c-lesekreis: #3b5f9e;
    --c-vortrag: #7a3e6e;
    --c-workshop: #b8781c;
    --c-stammtisch: #3f7a4f;
    --c-lesekreis-soft: #dfe7f5;
    --c-vortrag-soft: #efdfec;
    --c-workshop-soft: #f6e9d0;
    --c-stammtisch-soft: #dff0e3;
    max-width: 80rem;
    margin-inline: auto;
    padding: 1.5rem 1.25rem 7rem;
  }
  .t-lesekreis { --c: var(--c-lesekreis); --soft: var(--c-lesekreis-soft); }
  .t-vortrag { --c: var(--c-vortrag); --soft: var(--c-vortrag-soft); }
  .t-workshop { --c: var(--c-workshop); --soft: var(--c-workshop-soft); }
  .t-stammtisch { --c: var(--c-stammtisch); --soft: var(--c-stammtisch-soft); }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: end;
    padding-block: 1rem 2.5rem;
  }
  .brand {
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 400;
    line-height: 1.05;
    margin-bottom: 1rem;
  }
  .lede {
    max-width: 58ch;
    font-size: 1.1rem;
  }
  .links li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .links li:first-child {
    border-top: 1px solid var(--rule);
  }
  .links span {
    color: var(--muted);
    text-align: right;
  }
  a {
    text-underline-offset: 0.2em;
  }

  .calendar {
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
  }
  .cal-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .cal-bar h2 {
    font-size: 1.5rem;
    font-weight: 400;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .legend button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
  }
  .legend button i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--c);
  }
  .legend button:hover {
    border-color: var(--ink);
  }
  .legend button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .legend button[data-filter='all'][aria-pressed='true'] {
    background: var(--ink);
  }

  .months {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(30rem, 1fr));
    gap: 1.5rem 2.5rem;
  }
  .month h3 {
    font-weight: 400;
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--rule);
  }
  .wd {
    padding: 0.3rem 0.4rem;
    font-size: 0.85rem;
    color: var(--muted);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .cell {
    min-height: 4.6rem;
    padding: 0.3rem 0.35rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    font-size: 0.85rem;
  }
  .cell .n {
    color: var(--muted);
  }
  .cell.has .n {
    color: var(--ink);
  }
  .ev {
    display: block;
    margin-top: 0.25rem;
    padding: 0.25rem 0.4rem;
    background: var(--soft);
    border-left: 3px solid var(--c);
    color: var(--ink);
    text-decoration: none;
    line-height: 1.3;
    overflow: hidden;
  }
  .ev-time {
    display: block;
    color: var(--c);
  }
  .ev-title {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .list li {
    display: grid;
    grid-template-columns: 0.75rem 13rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .list i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--c);
    align-self: center;
  }
  .list time {
    color: var(--muted);
  }
  .list .place {
    color: var(--muted);
  }

  .types {
    padding-block: 3rem 2rem;
  }
  .types ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }
  .type {
    border-top: 4px solid var(--c);
    padding-top: 1rem;
  }
  .swatch {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--soft);
    color: var(--c);
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }
  .type h3 {
    font-size: 1.35rem;
    font-weight: 400;
  }
  .rhythm {
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .type-links {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.75rem;
  }
  .type-links a {
    color: var(--c);
  }

  .bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    border-top: 2px solid var(--ink);
    padding-top: 2rem;
  }
  .bottom h2 {
    font-size: 1.6rem;
    font-weight: 400;
    margin-bottom: 0.4rem;
  }
  .hang h2 {
    font-style: italic;
  }
  .actions {
    display: flex;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .actions a {
    display: inline-block;
    padding: 0.4rem 1rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    text-decoration: none;
  }
  .actions a:first-child {
    background: var(--ink);
    color: var(--bg);
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 64rem) {
    .types ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 52rem) {
    .top, .bottom {
      grid-template-columns: 1fr;
    }
    .months {
      display: none;
    }
    .list {
      margin-top: 0;
    }
    .list li {
      grid-template-columns: 0.75rem 1fr;
      grid-template-rows: auto auto auto;
      row-gap: 0.1rem;
    }
    .list li > :not(i) {
      grid-column: 2;
    }
    .list i {
      grid-row: 1;
      align-self: center;
    }
    .list time {
      grid-row: 1;
    }
    .list .place {
      grid-row: 3;
    }
  }
  @media (max-width: 36rem) {
    .types ul {
      grid-template-columns: 1fr;
    }
  }
</style>
