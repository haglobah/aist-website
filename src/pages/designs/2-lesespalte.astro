---
import Base from '../../layouts/Base.astro'
import TypeIcon from '../../components/TypeIcon.astro'
import { calendar, contact, eventTypes, hangout, hero, links, parts, site, typeById } from '../../data/site'
---

<Base title={`${site.name}: Lesespalte`} design={2}>
  <main class="page">
    <p class="margin brand">{site.name}</p>
    <header class="col hero" id="was">
      <h1>{hero.heading}</h1>
      <p class="lede">{hero.text}</p>
    </header>

    <p class="margin label">Mehr</p>
    <ul class="col links" role="list">
      {links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a> <span class="note">{l.note}</span>
        </li>
      ))}
    </ul>

    <p class="margin label">Persönlich</p>
    <aside class="col hang">
      <h2>{hangout.heading}</h2>
      <p>{hangout.text}</p>
      <p class="actions">
        {hangout.actions.map((a) => <a href={a.href}>{a.label}</a>)}
      </p>
    </aside>

    <p class="margin label">Filter</p>
    <div class="col filter" data-filter-group>
      <button data-filter="all" aria-pressed="true">Alles</button>
      {eventTypes.map((t) => <button data-filter={t.id}>{t.name}</button>)}
    </div>

    <h2 class="margin label">Formate</h2>
    <ul class="col types" role="list" data-filter-target>
      {eventTypes.map((t) => (
        <li class="type" data-event-type={t.id}>
          <h3><span class="ico"><TypeIcon type={t.id} strokeWidth={1.25} /></span>{t.name}</h3>
          <p class="rhythm">{t.rhythm}</p>
          <p>{t.description}</p>
          <p class="type-links">
            <a href={t.foodUrl}>Essen abstimmen</a>
            <a href={t.feedbackUrl}>Feedback geben</a>
          </p>
        </li>
      ))}
    </ul>

    <h2 class="margin label" id="kalender">Kalender</h2>
    <div class="col cal-head">
      <p>Wo, was, wann? Alle Termine sind offen, eine Anmeldung brauchst du nicht.</p>
    </div>
    <ol class="cal" role="list" data-filter-target>
      {calendar.map((e) => {
        const d = parts(e.date)
        return (
          <li data-event-type={e.type}>
            <time class="margin date" datetime={e.date}>
              <span class="day">{d.day}</span>
              <span class="mon">{d.monthShort} {d.weekday}</span>
            </time>
            <div class="col entry">
              <h3>{e.title}</h3>
              <p>{typeById(e.type).name}, {e.time} Uhr, {e.place}</p>
            </div>
          </li>
        )
      })}
    </ol>
    <p class="col empty" data-filter-empty hidden>Für dieses Format steht gerade nichts im Kalender.</p>

    <h2 class="margin label" id="kontakt">Kontakt</h2>
    <footer class="col contact">
      <h3>{contact.heading}</h3>
      <p>{contact.text}</p>
      <p class="socials">
        {contact.socials.map((s, i) => (
          <>
            <a href={s.href}>{s.label}</a>
            {i < contact.socials.length - 1 ? ' ' : ''}
          </>
        ))}
      </p>
    </footer>
  </main>
</Base>

<script src="../../scripts/filter.ts"></script>

<style>
  .page {
    --bg: #fbf9f4;
    --ink: #23201c;
    --accent: #2f5d3a;
    --muted: #7d786c;
    --rule: #ddd8cc;
    display: grid;
    grid-template-columns: [margin] 9rem [col] minmax(0, 38rem);
    column-gap: 2rem;
    row-gap: 0;
    justify-content: center;
    padding: 3rem 1.25rem 8rem;
    font-size: 1.06rem;
    line-height: 1.65;
  }
  .margin {
    grid-column: margin;
    text-align: right;
    color: var(--muted);
    font-style: italic;
    font-weight: 400;
    font-size: 1rem;
    padding-top: 0.25rem;
  }
  .col {
    grid-column: col;
  }
  .brand {
    color: var(--ink);
    font-style: normal;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    padding-top: 0.6rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.05;
    margin-bottom: 1.5rem;
  }
  .lede {
    font-size: 1.3rem;
    line-height: 1.5;
  }
  .label {
    margin-top: 3rem;
  }
  .links, .hang, .filter, .types, .cal-head, .contact {
    margin-top: 3rem;
  }
  .hero + .margin + .links {
    margin-top: 3rem;
  }
  a {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .links li {
    padding: 0.15rem 0;
  }
  .links .note {
    color: var(--muted);
    margin-left: 0.35rem;
  }
  .hang {
    padding-left: 1.25rem;
    border-left: 3px solid var(--accent);
  }
  .hang h2 {
    font-size: 1.6rem;
    font-weight: 400;
    font-style: italic;
    margin-bottom: 0.4rem;
  }
  .actions {
    margin-top: 0.75rem;
    display: flex;
    gap: 1.5rem;
  }
  .actions a {
    font-weight: 700;
  }
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .filter button {
    background: none;
    border: 0;
    padding: 0;
    color: var(--muted);
    text-decoration: none;
  }
  .filter button:hover {
    color: var(--ink);
  }
  .filter button[aria-pressed='true'] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .type {
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
  }
  .type:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .type h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
  }
  .ico {
    display: inline-flex;
    color: var(--accent);
    font-size: 1.3rem;
  }
  .rhythm {
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .type-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }
  .cal {
    display: contents;
  }
  .cal li {
    display: contents;
  }
  .cal-head p {
    color: var(--muted);
  }
  .date {
    font-style: normal;
    color: var(--accent);
    line-height: 1;
    padding-top: 1.35rem;
  }
  .date .day {
    display: block;
    font-size: 2.4rem;
    font-weight: 400;
  }
  .date .mon {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .entry {
    padding: 1.25rem 0;
    border-top: 1px solid var(--rule);
  }
  .entry h3 {
    font-size: 1.25rem;
    font-weight: 400;
  }
  .entry p {
    color: var(--muted);
  }
  .empty {
    color: var(--muted);
    font-style: italic;
    margin-top: 1rem;
  }
  .contact h3 {
    font-size: 1.6rem;
    font-weight: 400;
    font-style: italic;
    margin-bottom: 0.4rem;
  }
  .socials {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  @media (max-width: 50rem) {
    .page {
      grid-template-columns: [margin col] minmax(0, 38rem);
    }
    .margin {
      text-align: left;
      padding-top: 0;
      margin-bottom: 0.25rem;
    }
    .label {
      margin-top: 2.5rem;
    }
    .links, .hang, .filter, .types, .cal-head, .contact {
      margin-top: 0.25rem;
    }
    .date {
      display: flex;
      gap: 0.6rem;
      align-items: baseline;
      padding-top: 1.25rem;
      border-top: 1px solid var(--rule);
      margin-bottom: 0;
    }
    .date .day {
      font-size: 1.5rem;
    }
    .date .mon {
      margin-top: 0;
    }
    .entry {
      border-top: 0;
      padding-top: 0.25rem;
    }
  }
</style>
