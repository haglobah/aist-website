---
import Base from '../../layouts/Base.astro'
import TypeIcon from '../../components/TypeIcon.astro'
import { calendar, contact, eventTypes, hangout, hero, links, parts, site, typeById } from '../../data/site'
---

<Base title={`${site.name}: Aushang`} design={1}>
  <div class="page">
    <header class="top">
      <a class="brand" href="/designs/1-aushang">{site.name}</a>
      <span class="tag">{site.tagline}</span>
    </header>

    <section class="hero" id="was">
      <h1>{hero.heading}</h1>
      <p>{hero.text}</p>
    </section>

    <section class="intro">
      <ul class="links" role="list">
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
            <span>{l.note}</span>
          </li>
        ))}
      </ul>
      <aside class="hang">
        <h2>{hangout.heading}</h2>
        <p>{hangout.text}</p>
        <p class="actions">
          {hangout.actions.map((a) => <a href={a.href}>{a.label}</a>)}
        </p>
      </aside>
    </section>

    <div class="filter" data-filter-group>
      <span class="filter-label">Filter:</span>
      <button data-filter="all" aria-pressed="true">Alle</button>
      {eventTypes.map((t) => <button data-filter={t.id}>{t.name}</button>)}
    </div>

    <section class="body">
      <div class="types">
        <h2 class="visually-hidden">Event-Typen</h2>
        <ul role="list" data-filter-target>
          {eventTypes.map((t) => (
            <li class="type" data-event-type={t.id}>
              <span class="mark"><TypeIcon type={t.id} /></span>
              <div>
                <h3>{t.name}</h3>
                <p class="rhythm">{t.rhythm}</p>
                <p>{t.description}</p>
                <p class="type-links">
                  <a href={t.foodUrl}>Essen abstimmen</a>
                  <a href={t.feedbackUrl}>Feedback geben</a>
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <aside class="cal" id="kalender">
        <h2>Kalender</h2>
        <p class="sub">Wo, was, wann?</p>
        <ol role="list" data-filter-target>
          {calendar.map((e) => {
            const d = parts(e.date)
            return (
              <li data-event-type={e.type}>
                <time datetime={e.date}>
                  <b>{d.weekday} {d.day}.</b> {d.monthShort}
                </time>
                <div>
                  <span class="title">{e.title}</span>
                  <span class="meta">{typeById(e.type).name}, {e.time} Uhr, {e.place}</span>
                </div>
              </li>
            )
          })}
        </ol>
        <p data-filter-empty hidden>Für diesen Typ steht gerade nichts im Kalender.</p>
      </aside>
    </section>

    <footer class="contact" id="kontakt">
      <div>
        <h2>{contact.heading}</h2>
        <p>{contact.text}</p>
      </div>
      <ul role="list" class="socials">
        {contact.socials.map((s) => (
          <li><a href={s.href}>{s.label}</a></li>
        ))}
      </ul>
      <a class="button" href={`mailto:${contact.email}`}>Schreib uns</a>
    </footer>
  </div>
</Base>

<script src="../../scripts/filter.ts"></script>

<style>
  .page {
    --bg: #f8f6f1;
    --ink: #1b1b1f;
    --accent: #1f2a5a;
    --rule: #cfcabf;
    --muted: #6b6860;
    max-width: 72rem;
    margin-inline: auto;
    padding: 1.25rem 1.25rem 7rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 0.5rem 1rem;
    border-bottom: 1px solid var(--ink);
  }
  .brand {
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .tag {
    color: var(--muted);
  }

  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem) 2rem;
    max-width: 62ch;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: 1.05;
    font-weight: 400;
    margin-bottom: 1.25rem;
  }
  .hero p {
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding-block: 1.5rem 3rem;
  }
  .links li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule);
  }
  .links li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .links a {
    color: var(--accent);
    text-underline-offset: 0.2em;
  }
  .links span {
    color: var(--muted);
  }
  .hang {
    border: 1px solid var(--accent);
    padding: 1.25rem 1.5rem 1.5rem;
    color: var(--accent);
  }
  .hang h2 {
    font-style: italic;
    font-weight: 400;
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
  }
  .hang p {
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .actions a {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
  .actions a:first-child {
    background: var(--accent);
    color: var(--bg);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .filter-label {
    margin-right: 0.5rem;
    color: var(--muted);
  }
  .filter button {
    background: none;
    border: 1px solid transparent;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
  }
  .filter button:hover {
    border-color: var(--rule);
  }
  .filter button[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .body {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 3rem;
    padding-block: 2rem 3rem;
  }
  .type {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.25rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .type:first-child {
    padding-top: 0.5rem;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
    font-size: 1.5rem;
  }
  .type h3 {
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.2;
  }
  .rhythm {
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .type-links {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.75rem;
  }
  .type-links a {
    color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .cal {
    align-self: start;
    position: sticky;
    top: 1.5rem;
    border: 1px solid var(--ink);
    padding: 1.25rem 1.5rem 1.5rem;
    background: var(--bg);
  }
  .cal h2 {
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.1;
  }
  .sub {
    color: var(--muted);
    font-style: italic;
    margin-bottom: 1rem;
  }
  .cal li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--rule);
  }
  .cal time {
    color: var(--accent);
    line-height: 1.3;
  }
  .cal time b {
    font-weight: 400;
    display: block;
  }
  .cal .title {
    display: block;
  }
  .cal .meta {
    display: block;
    color: var(--muted);
    font-size: 0.92rem;
  }
  [data-filter-empty] {
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-style: italic;
  }

  .contact {
    display: grid;
    grid-template-columns: 1.25fr 1fr auto;
    gap: 2rem;
    align-items: start;
    padding-block: 2.5rem 2rem;
    border-top: 1px solid var(--ink);
  }
  .contact h2 {
    font-size: 1.6rem;
    font-weight: 400;
    margin-bottom: 0.4rem;
  }
  .socials li {
    padding: 0.3rem 0;
  }
  .socials a {
    color: var(--accent);
    text-underline-offset: 0.2em;
  }
  .button {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
  }

  @media (max-width: 52rem) {
    .intro, .body, .contact {
      grid-template-columns: 1fr;
    }
    .cal {
      position: static;
    }
    .links li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
