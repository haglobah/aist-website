---
import Base from '../layouts/Base.astro'
import TypeIcon from '../components/TypeIcon.astro'
import { resolveCalendar, contact, eventTypes, hangout, hero, links, parts, site, typeById } from '../data/site'

const accentLink = 'text-accent underline underline-offset-[0.2em]'
---

<Base title={site.name}>
  <div class="mx-auto max-w-6xl px-5 pt-5 pb-28">
    <header class="flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-b border-ink pt-2 pb-4">
      <div class="flex flex-wrap items-baseline gap-x-4">
        <a class="text-[1.4rem] font-bold tracking-[0.04em]" href="/">{site.name}</a>
        <span class="text-muted">{site.tagline}</span>
      </div>
      <nav aria-label="Main navigation" class="flex flex-wrap gap-x-6">
        {links.map((l) => (
          <a class={`${accentLink} inline-flex min-h-10 items-center`} href={l.href}>{l.label}</a>
        ))}
      </nav>
    </header>

    <section class="grid items-start gap-8 pt-[clamp(2.5rem,7vw,5rem)] pb-12 md:grid-cols-[1.25fr_1fr] md:gap-12">
      <div class="max-w-[62ch]" id="about">
        <h1 class="mb-5 text-[clamp(2.0rem,5vw,3.8rem)] leading-[1.05]">{hero.heading}</h1>
        <p class="text-[1.15rem] leading-[1.6]">{hero.text}</p>
      </div>
      <aside class="px-6 pt-5 pb-6 text-accent">
        <h2 class="mb-2 text-[1.6rem]">{hangout.heading}</h2>
        <p class="text-ink">{hangout.text}</p>
        <p class="mt-4 grid grid-cols-2 auto-rows-fr gap-[0.6rem]">
          {hangout.actions.map((a) => (
            <a
              class:list={[
                'flex min-h-10 items-center justify-center border-4 border-ink bg-paper px-[0.9rem] py-[0.35rem] text-center text-ink hover:bg-ink hover:text-paper',
                { 'col-span-2': a.href === '#contact' },
              ]}
              href={a.href}
            >
              {a.label}
            </a>
          ))}
        </p>
      </aside>
    </section>

    <section class="grid gap-8 pt-4 pb-6 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
      <div>
        <h2 class="sr-only">Event types</h2>
        <ul role="list" data-filter-group>
          {eventTypes.map((t) => (
            <li
              class="group/card grid grid-cols-[2.75rem_minmax(0,1fr)] gap-3 py-4 first:pt-1"
              data-filter-card={t.id}
            >
              <h3 class="col-span-2">
                <button
                  type="button"
                  class="group grid w-full cursor-pointer grid-cols-[2.75rem_minmax(0,1fr)] items-center gap-3 rounded-sm text-left text-accent"
                  data-filter={t.id}
                  aria-pressed="false"
                  aria-controls="calendar-events"
                  title="Filter the calendar; select again to show all events"
                >
                  <span class="grid size-11 place-items-center rounded-full border border-accent text-xl transition-colors group-hover/card:bg-accent/10 group-aria-pressed:bg-accent group-aria-pressed:text-paper">
                    <TypeIcon type={t.id} />
                  </span>
                  <span class="text-xl leading-[1.2] group-hover/card:underline group-aria-pressed:underline underline-offset-4">{t.name}</span>
                </button>
              </h3>
              <div class="col-start-2 -mt-3 text-[0.95rem] leading-[1.45]">
                {t.schedule && <p class="mb-1 text-muted">{t.schedule.dayLabel}, {t.schedule.time}, {t.schedule.place}</p>}
                <p>{t.description}</p>
                <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
                  <a class={accentLink} href={t.foodUrl}>Vote on food</a>
                  <a class={accentLink} href={t.feedbackUrl}>Give feedback</a>
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <aside class="self-start border border-ink bg-paper md:sticky md:top-6" id="calendar">
        <ol role="list" id="calendar-events" data-filter-target aria-live="polite">
          {resolveCalendar().map((e) => {
            const d = parts(e.date)
            return (
              <li class="grid grid-cols-[5rem_minmax(0,1fr)] px-9 py-4" data-event-type={e.type} data-calendar-index={e.index}>
                <time class="text-[1.05rem] leading-[1.3] text-accent tabular-nums" datetime={e.date}>
                  <b class="block font-bold">{d.weekday} {d.day}</b> <span data-calendar-month>{d.monthShort}</span>
                </time>
                <div>
                  <span class="block text-[1.1rem] leading-snug font-bold">{e.title}</span>
                  <span class="mt-1 block text-[0.95rem] text-muted">{typeById(e.type).name}, <span data-calendar-time>{e.time}</span>, {e.place}</span>
                </div>
              </li>
            )
          })}
        </ol>
        <p class="border-t border-rule pt-4 text-muted italic" data-filter-empty hidden>
          No events of this type are currently scheduled.
        </p>
      </aside>
    </section>

    <footer class="grid items-start gap-8 pt-10 pb-8 md:grid-cols-[1.25fr_1fr_auto]" id="contact">
      <div>
        <h2 class="mb-[0.4rem] text-[1.6rem]">{contact.heading}</h2>
        <p>{contact.text}</p>
      </div>
      <ul role="list">
        {contact.socials.map((s) => (
          <li class="py-[0.3rem]"><a class={accentLink} href={s.href}>{s.label}</a></li>
        ))}
      </ul>
      <a class="inline-block bg-accent px-5 py-[0.6rem] text-paper" href={`mailto:${contact.email}`}>Write to us</a>
    </footer>
  </div>
</Base>

<script src="../scripts/filter.ts"></script>

<script src="../scripts/calendar.ts"></script>
